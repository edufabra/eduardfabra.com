---
import ArrowRight from 'lucide-astro/ArrowRight';
import Mail from 'lucide-astro/Mail';
import MapPin from 'lucide-astro/MapPin';
import Github from 'lucide-astro/Github';
import Linkedin from 'lucide-astro/Linkedin';
import { Image } from 'astro:assets';
import Card from '../Card.astro';
import portrait from '../../assets/eduard-fabra.jpg';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isExternalDemo = site.links.vialystDemo.startsWith('http');
---

<section aria-labelledby="hero-title" class="grid gap-4 lg:grid-cols-3">
	<Card class="relative overflow-hidden lg:col-span-2 lg:p-12">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-accent/20 blur-3xl"
		>
		</div>
		<h1 id="hero-title" class="relative text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
			<span class="block text-muted">{t.hero.greeting}</span>
			<span class="block">{site.name}.</span>
			<span class="mt-3 block text-2xl font-medium text-foreground/90 sm:text-3xl">
				{t.hero.role}
			</span>
		</h1>
		<p class="relative mt-6 max-w-2xl text-lg text-pretty text-muted">{t.hero.subtitle}</p>
		<div class="relative mt-8 flex flex-col gap-3 sm:flex-row">
			<a
				href={site.links.vialystDemo}
				{...isExternalDemo && { target: '_blank', rel: 'noopener noreferrer' }}
				class="group inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 font-medium text-white transition-colors hover:bg-blue-600"
			>
				{t.hero.ctaDemo}
				{isExternalDemo && <span class="sr-only">{t.a11y.externalLink}</span>}
				<ArrowRight size={18} aria-hidden="true" class="transition-transform group-hover:translate-x-0.5" />
			</a>
			<a
				href="#contact"
				class="inline-flex items-center justify-center gap-2 rounded-xl border border-edge px-5 py-3 font-medium transition-colors hover:border-accent hover:text-accent"
			>
				<Mail size={18} aria-hidden="true" />
				{t.hero.ctaContact}
			</a>
		</div>
	</Card>

	<Card class="relative flex flex-col gap-6 overflow-hidden">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-accent/20 blur-3xl"
		>
		</div>
		<div class="relative flex flex-col items-center gap-4 text-center">
			<Image
				src={portrait}
				alt=""
				widths={[160, 320]}
				sizes="160px"
				loading="eager"
				fetchpriority="high"
				class="size-32 rounded-full object-cover ring-2 ring-accent ring-offset-4 ring-offset-surface sm:size-40"
			/>
			<div>
				<p class="text-lg font-semibold">{site.name}</p>
				<p class="flex items-center justify-center gap-1 text-sm text-muted">
					<MapPin size={14} aria-hidden="true" />
					{t.hero.location}
				</p>
			</div>
		</div>
		<ul class="relative flex flex-wrap justify-center gap-2" aria-label="Stack">
			{
				['PHP', 'Symfony', 'AWS', 'E-commerce'].map((tag) => (
					<li class="rounded-lg border border-edge bg-background px-3 py-1.5 text-sm text-foreground/90">{tag}</li>
				))
			}
		</ul>
		<ul class="relative mt-auto grid grid-cols-3 gap-3">
			<li>
				<a
					href={site.links.github}
					target="_blank"
					rel="noopener noreferrer me"
					class="flex h-14 items-center justify-center rounded-xl border border-edge bg-background text-muted transition-colors hover:border-accent hover:text-accent"
				>
					<Github size={22} aria-hidden="true" />
					<span class="sr-only">GitHub {t.a11y.externalLink}</span>
				</a>
			</li>
			<li>
				<a
					href={site.links.linkedin}
					target="_blank"
					rel="noopener noreferrer me"
					class="flex h-14 items-center justify-center rounded-xl border border-edge bg-background text-muted transition-colors hover:border-accent hover:text-accent"
				>
					<Linkedin size={22} aria-hidden="true" />
					<span class="sr-only">LinkedIn {t.a11y.externalLink}</span>
				</a>
			</li>
			<li>
				<a
					href={`mailto:${site.links.email}`}
					class="flex h-14 items-center justify-center rounded-xl border border-edge bg-background text-muted transition-colors hover:border-accent hover:text-accent"
				>
					<Mail size={22} aria-hidden="true" />
					<span class="sr-only">{t.about.email}</span>
				</a>
			</li>
		</ul>
	</Card>
</section>

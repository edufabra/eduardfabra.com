---
import Menu from 'lucide-astro/Menu';
import X from 'lucide-astro/X';
import LanguagePicker from './LanguagePicker.astro';
import { localeUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
	{ href: '#vialyst', label: t.nav.vialyst },
	{ href: '#stack', label: t.nav.stack },
	{ href: '#about', label: t.nav.about },
	{ href: '#projects', label: t.nav.projects },
	{ href: '#experience', label: t.nav.experience },
];
---

<header class="sticky top-0 z-40 border-b border-edge/60 bg-background/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<a href={localeUrl(lang)} class="font-semibold tracking-tight">
			Eduard<span class="text-accent">.</span>
		</a>

		<nav aria-label={t.a11y.mainNav}>
			<ul
				id="main-menu"
				class="absolute inset-x-0 top-16 hidden flex-col gap-1 border-b border-edge bg-background p-4 text-sm md:static md:flex md:flex-row md:border-0 md:bg-transparent md:p-0"
			>
				{
					links.map(({ href, label }) => (
						<li>
							<a
								href={href}
								class="block rounded-lg px-3 py-2 text-muted transition-colors hover:bg-surface hover:text-foreground"
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<LanguagePicker lang={lang} />
			<button
				type="button"
				id="menu-toggle"
				class="inline-flex size-10 items-center justify-center rounded-lg text-muted hover:text-foreground md:hidden"
				aria-expanded="false"
				aria-controls="main-menu"
			>
				<span class="sr-only">{t.a11y.openMenu}</span>
				<Menu class="menu-open" size={22} aria-hidden="true" />
				<X class="menu-close hidden" size={22} aria-hidden="true" />
			</button>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('main-menu');

	const setOpen = (open: boolean) => {
		toggle?.setAttribute('aria-expanded', String(open));
		menu?.classList.toggle('hidden', !open);
		menu?.classList.toggle('flex', open);
		toggle?.querySelector('.menu-open')?.classList.toggle('hidden', open);
		toggle?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
	};

	toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
	menu?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) setOpen(false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			toggle.focus();
		}
	});
</script>

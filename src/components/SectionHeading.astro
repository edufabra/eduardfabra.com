---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	intro?: string;
}

const { id, eyebrow, title, intro } = Astro.props;
---

<header class="mb-8 max-w-2xl sm:mb-10">
	<p class="mb-2 text-sm font-semibold tracking-widest text-accent uppercase">{eyebrow}</p>
	<h2 id={id} class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
	{intro && <p class="mt-3 text-lg text-muted">{intro}</p>}
</header>
